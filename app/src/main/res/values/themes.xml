<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Contact_app_recycler_view" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/color_tertiary</item>
        <item name="colorOnPrimaryContainer">@color/color_primary</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/color_accent</item>
        <item name="colorOnSecondaryContainer">@color/color_primary</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/color_primary</item>

        <!-- Background color -->
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.Contact_app_recycler_view" parent="Base.Theme.Contact_app_recycler_view" />

    <style name="CircleImage" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>